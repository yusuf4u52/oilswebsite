# Public (exposed to the browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=https://frontend-next-seven-ashy.vercel.app

# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=premium_oils

# Auth
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
GOOGLE_MODE=mock
GOOGLE_CLIENT_ID=

# MSG91 SMS (order-status notifications)
MSG91_AUTH_KEY=
MSG91_ORDER_CONFIRMED_TEMPLATE_ID=
MSG91_ORDER_SHIPPED_TEMPLATE_ID=
MSG91_ORDER_DELIVERED_TEMPLATE_ID=
MSG91_ORDER_CANCELLED_TEMPLATE_ID=

# Razorpay
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP email
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
