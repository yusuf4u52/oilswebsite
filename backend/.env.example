MONGO_URL=mongodb://localhost:27017
DB_NAME=premium_oils
JWT_SECRET=your_jwt_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
# Set GOOGLE_MODE=live and fill in GOOGLE_CLIENT_ID (from Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID -> Web application) to enable real
# Google Sign-In. In mock mode /api/auth/google accepts a fake JSON profile instead of
# a verified Google credential, so local dev/tests work without a real Google project.
GOOGLE_MODE=mock
GOOGLE_CLIENT_ID=
MSG91_AUTH_KEY=
# Order status SMS notifications (optional - only sent if both MSG91_AUTH_KEY above
# and the relevant template id below are set). Each must be a DLT-approved Flow
# template with an "ORDER_ID" variable.
MSG91_ORDER_CONFIRMED_TEMPLATE_ID=
MSG91_ORDER_SHIPPED_TEMPLATE_ID=
MSG91_ORDER_DELIVERED_TEMPLATE_ID=
MSG91_ORDER_CANCELLED_TEMPLATE_ID=
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Order emails (order confirmation + shipped/delivered/cancelled updates to the customer,
# plus a new-order alert to ADMIN_EMAIL above). Set EMAIL_MODE=live and fill in the SMTP_*
# vars below to send for real; mock mode just logs the email instead. Works with any SMTP
# provider (Gmail app password, Zoho Mail, Amazon SES SMTP, a custom domain mailbox, etc.).
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
CORS_ORIGINS=http://localhost:3000,https://premiumoils.in,https://www.premiumoils.in
